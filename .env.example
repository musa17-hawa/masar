# Copy to .env and adjust. Every value is optional.
PORT=3000
HOST=0.0.0.0
# Where uploads, processed trails and the account database live.
DATA_DIR=./data
# Create the first admin automatically on first start (otherwise open /setup in the browser).
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Your name
# Processing limits — the defaults suit a small box with 8 GB RAM or less.
POINT_BUDGET=1500000
DEM_MAX_CELLS=1536
WORKER_MEMORY_MB=3072
MAX_UPLOAD_GB=6
# Set to 0 to stop the server from calling OpenStreetMap / imagery services.
ALLOW_NETWORK=1

# Cloudflare Tunnel token, only used by the optional cloudflared service in docker-compose.yml.
# TUNNEL_TOKEN=
